{
  "info": {
    "name": "Hubpieces API",
    "description": "Collection de smoke tests pour l'API Hubpieces (sessions par rôle; compléter les identifiants et fichiers pour les mutations)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Login (Demandeur)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"demandeur@hubpieces.fr\", \"motDePasse\": \"demo1234\"}"
            }
          }
        },
        {
          "name": "Login (Maker)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"maker@hubpieces.fr\", \"motDePasse\": \"demo1234\"}"
            }
          }
        },
        {
          "name": "Login (Expert CAO)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"expert@hubpieces.fr\", \"motDePasse\": \"demo1234\"}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@hubpieces.fr\", \"motDePasse\": \"admin123\"}"
            }
          }
        },
        {
          "name": "Register nouveau demandeur",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Test\", \"prenom\": \"User\", \"email\": \"test@example.com\", \"motDePasse\": \"test1234\", \"role\": \"DEMANDEUR\"}"
            }
          }
        },
        {
          "name": "Qui suis-je",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
