            "url": "{{baseUrl}}/api/demandeur/demandes",
            "body": {
              "mode": "raw",
              "raw": "{\"titre\": \"Test\", \"description\": \"Test\", \"marque\": \"Samsung\", \"budgetMax\": 20}"
            }
          }
        },
